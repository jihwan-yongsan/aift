const express = require('express');
const { Pool } = require('pg');
require('dotenv').config();

const app = express();
const pool = new Pool({
  connectionString: process.env.DATABASE_URL,
  ssl: { rejectUnauthorized: false }
});

app.use(express.static('public'));

// DB에서 목록을 가져오는 약속된 주소(API)
app.get('/api/items', async (req, res) => {
  try {
    const result = await pool.query('SELECT * FROM lost_items ORDER BY found_date DESC');
    res.json(result.rows); // 데이터를 브라우저에게 전달
  } catch (err) {
    res.status(500).send('DB 연결 오류');
  }
});

const PORT = process.env.PORT || 3000;
app.listen(PORT, () => console.log(`${PORT}번 포트에서 서버 시작!`));
